<div class="container"  style="display: flex; justify-content: center>
    <div class="row">
        <div class="col-md-6 offset-md-3">
            <div class="panel">
                <h4 class="panel-title">Actualizar producto</h4>
                <form action="/productos/{{productos._id}}/update" method="post">
                    <div class="field">
                        <label for="nombre">Nombre</label>
                        <input type="text" name="nombre" placeholder="Nombre del producto" id="nombre" value="{{productos.nombre}}" class="form-control">
                    </div>
                    <div class="field">
                        <label for="descripcion">Descripción</label>
                        <textarea name="descripcion" id="descripcion" cols="30" rows="3" placeholder="Descripción" class="form-control">{{productos.descripcion}}</textarea>
                    </div>
                    <div class="field">
                        <label for="precio">Precio</label>
                        <input type="text" name="precio" placeholder="0.00" id="precio" value="{{productos.precio}}" class="form-control">
                    </div>
                    <button class="btn btn-info btn-sm mt-2">Actualizar</button>
                    <a href="/productos" class="btn btn-secondary btn-sm mt-2 ms-2">Cancelar</a>
                </form>
            </div>
        </div>
    </div>
</div>
